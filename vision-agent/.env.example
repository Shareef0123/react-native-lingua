# AI language teacher — environment.
# Copy to .env and fill in the value below. Never commit .env (it is gitignored).

# Google (Gemini) — powers the Gemini Realtime model (the teacher's brain + voice).
# This key is specific to this service. Server-side only, never in the mobile app.
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=...

# Stream (getstream) credentials are NOT set here. They are reused from the Expo
# app's root .env (../.env) as EXPO_STREAM_API_KEY / EXPO_STREAM_API_SECRET and
# bridged to STREAM_API_KEY / STREAM_API_SECRET by env_bootstrap.py.
# Override here only if you want this service to use a different Stream project:
# STREAM_API_KEY=
# STREAM_API_SECRET=

# Optional: which language the teacher teaches (it always *speaks* English).
# Defaults to Spanish. Used only as a fallback — when launched from the app, the
# lesson (language, goals, vocabulary, phrases, prompt) is read from the Stream
# call's custom data on join.
# TARGET_LANGUAGE=Spanish

# Optional: shared secret the Expo agent-session route sends as a bearer token
# when starting/stopping sessions. Only needed if you enforce it via ServeOptions
# (can_start_session) in a custom serve setup. Must match VISION_AGENT_TOKEN in
# the app root .env.
# VISION_AGENT_TOKEN=
