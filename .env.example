# Copy to .env and fill in real values. Never commit .env (it is gitignored).

# Clerk — publishable key is safe to expose to the client (EXPO_PUBLIC_ prefix).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
# Clerk secret key — SERVER ONLY. Used by the Expo API routes to verify the
# user's session token. Never expose to the client.
CLERK_SECRET_KEY=sk_test_xxx

# Stream (GetStream) — the API key is not secret; the secret must stay server-side.
# Both are read only inside the Expo API routes (lib/server/stream.ts).
EXPO_STREAM_API_KEY=xxx
EXPO_STREAM_API_SECRET=xxx

# Vision Agent (AI teacher) HTTP server — SERVER ONLY. The Expo API routes proxy
# to it to start/stop the AI teacher; the mobile app never talks to it directly.
# Defaults to http://localhost:8000 when unset (the `uv run agent.py serve` port).
# VISION_AGENT_URL=http://localhost:8000
# Optional shared secret sent to the agent server as a bearer token (must match
# VISION_AGENT_TOKEN in vision-agent/.env). Leave unset if the agent server is open.
# VISION_AGENT_TOKEN=
